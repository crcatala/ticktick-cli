{
  "name": "@crcatala/ticktick-cli",
  "version": "0.1.0",
  "description": "Command-line interface for TickTick task management",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "tt": "./dist/index.js",
    "ttcli": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "bun run verify",
    "dev": "bun run src/index.ts",
    "clean": "node -e \"for (const path of ['dist', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "build": "bun run clean && tsc --build",
    "test": "bun --raw-test",
    "test:watch": "bun --raw-test --watch",
    "test:coverage": "bun --raw-test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "schema:capture": "bun run scripts/schema-capture.ts",
    "test:package": "bash scripts/test-package.sh",
    "verify": "bun run test && bun run lint && bun run typecheck && bun run build && bun run test:package",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:prep": "./scripts/prep-release.sh"
  },
  "keywords": [
    "ticktick",
    "cli",
    "todo",
    "task",
    "productivity",
    "task-management",
    "command-line"
  ],
  "author": "crcatala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcatala/ticktick-cli.git"
  },
  "homepage": "https://github.com/crcatala/ticktick-cli#readme",
  "bugs": {
    "url": "https://github.com/crcatala/ticktick-cli/issues"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "keytar": "^7.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^7.0.0",
    "@types/bun": "^1.1.14",
    "msw": "^2.12.4",
    "oxlint": "^1.39.0",
    "release-it": "^20.2.1",
    "typescript": "^7.0.2"
  }
}
