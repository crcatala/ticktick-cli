{
  "name": "ticktick-cli",
  "version": "0.1.0",
  "description": "Command-line interface for TickTick task management",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "ticktick": "./dist/index.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "bun run src/index.ts",
    "build": "tsgo --build",
    "build:binary": "bun build ./src/index.ts --compile --outfile dist/ticktick",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsgo --noEmit",
    "schema:capture": "bun run scripts/schema-capture.ts"
  },
  "keywords": [
    "ticktick",
    "cli",
    "todo",
    "task",
    "productivity",
    "task-management",
    "command-line"
  ],
  "author": "crcatala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcatala/ticktick-cli.git"
  },
  "homepage": "https://github.com/crcatala/ticktick-cli#readme",
  "bugs": {
    "url": "https://github.com/crcatala/ticktick-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^14.0.0",
    "keytar": "^7.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "msw": "^2.12.4",
    "typescript": "^5.7.2"
  }
}
